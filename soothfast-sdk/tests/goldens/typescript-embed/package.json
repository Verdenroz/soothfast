{
  "name": "acme-items",
  "version": "1.2.3",
  "description": "Acme items client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acme/items"
  },
  "optionalDependencies": {
    "acme-items-darwin-arm64": "1.2.3",
    "acme-items-darwin-x64": "1.2.3",
    "acme-items-linux-arm64": "1.2.3",
    "acme-items-linux-x64": "1.2.3",
    "acme-items-win32-x64": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
