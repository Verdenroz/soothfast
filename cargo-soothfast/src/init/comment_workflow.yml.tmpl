name: soothfast-comment

# Written by `cargo soothfast init`; `cargo soothfast init --check` reports drift.
# Comments the verdict of a fork's pull request, whose own run cannot. The
# trigger is safe here: nothing of the pull request is checked out and its
# artifacts are only read as data.
on: # zizmor: ignore[dangerous-triggers]
  workflow_run:
    workflows: [soothfast]
    types: [completed]

permissions: {}

jobs:
  comment:
    permissions:
      actions: read
      contents: read
      pull-requests: write
    uses: @@action@@
    with:
      soothfast_ref: "@@pin@@"
