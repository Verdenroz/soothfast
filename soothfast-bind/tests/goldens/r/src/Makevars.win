TARGET = x86_64-pc-windows-gnu

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libacme_core.a
PKG_LIBS = -L$(LIBDIR) -lacme_core -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --lib --release --target=$(TARGET) --manifest-path=./rust/Cargo.toml --target-dir="$(TARGET_DIR)"

clean:
	rm -Rf $(SHLIB) $(OBJECTS) "$(TARGET_DIR)"
